[Unit]
Description=Temporary Venmail outbound SMTP containment for Netcup incident
Before=docker.service
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/venmail-smtp-egress-guard.nft
ExecStop=/usr/sbin/nft destroy table inet venmail_smtp_egress

[Install]
WantedBy=multi-user.target
